# Uso local: copie para .env (que não é versionado). No GitHub, cadastre os mesmos nomes em
# Settings → Secrets and variables → Actions (veja docs/operations.md).

# Pasta do histórico (clone local do repositório privado jobradar-data)
JOBRADAR_LAKE=../jobradar-data

# Adzuna (opcional) — https://developer.adzuna.com
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# E-mail (SMTP). Gmail: smtp.gmail.com, porta 587 e uma senha de app (não a senha da conta)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=
