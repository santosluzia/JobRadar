{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/santosluzia/jobradar/public-data/v1/skill-trends.schema.json",
  "title": "JobRadar skill-trends (1.0.0)",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^1\\.\\d+\\.\\d+$"
    },
    "dataset": {
      "const": "skill-trends"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "data_window": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "start": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "end": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        }
      },
      "required": [
        "start",
        "end"
      ]
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "source": {
                "type": "string"
              },
              "status_last_run": {
                "enum": [
                  "ok",
                  "erro"
                ]
              },
              "last_success_at": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date-time"
              },
              "records_last_run": {
                "type": "integer",
                "minimum": 0
              },
              "jobs_in_history": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "source",
              "status_last_run",
              "last_success_at",
              "records_last_run",
              "jobs_in_history"
            ]
          }
        },
        "observations": {
          "type": "integer",
          "minimum": 0
        },
        "note": {
          "type": "string"
        }
      },
      "required": [
        "sources",
        "observations",
        "note"
      ]
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "taxonomy": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "category": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "name",
              "category"
            ]
          }
        },
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "families": {
              "type": "array",
              "items": {
                "enum": [
                  "engenharia_dados",
                  "analytics_engineering",
                  "desenvolvimento_dados",
                  "analise_dados",
                  "governanca_qualidade",
                  "outra"
                ]
              }
            },
            "cohort": {
              "const": "mes_da_primeira_observacao"
            }
          },
          "required": [
            "families",
            "cohort"
          ]
        },
        "min_sample": {
          "type": "integer",
          "minimum": 0
        },
        "current": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "window_days": {
              "type": "integer",
              "minimum": 0
            },
            "n": {
              "type": "integer",
              "minimum": 0
            },
            "low_sample": {
              "type": "boolean"
            },
            "skills": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "skill_id": {
                    "type": "string"
                  },
                  "jobs": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "required_jobs": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "pct": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 100
                  },
                  "required_pct": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 100
                  }
                },
                "required": [
                  "skill_id",
                  "jobs",
                  "required_jobs",
                  "pct",
                  "required_pct"
                ]
              }
            }
          },
          "required": [
            "window_days",
            "n",
            "low_sample",
            "skills"
          ]
        },
        "monthly": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "month": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}$"
              },
              "skill_id": {
                "type": "string"
              },
              "jobs": {
                "type": "integer",
                "minimum": 0
              },
              "total_jobs": {
                "type": "integer",
                "minimum": 0
              },
              "pct": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              "low_sample": {
                "type": "boolean"
              }
            },
            "required": [
              "month",
              "skill_id",
              "jobs",
              "total_jobs",
              "pct",
              "low_sample"
            ]
          }
        },
        "by_seniority": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "seniority": {
                "enum": [
                  "estagio",
                  "junior",
                  "pleno",
                  "senior",
                  "lideranca",
                  "nao_informada"
                ]
              },
              "skill_id": {
                "type": "string"
              },
              "jobs": {
                "type": "integer",
                "minimum": 0
              },
              "total_jobs": {
                "type": "integer",
                "minimum": 0
              },
              "pct": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              "low_sample": {
                "type": "boolean"
              }
            },
            "required": [
              "seniority",
              "skill_id",
              "jobs",
              "total_jobs",
              "pct",
              "low_sample"
            ]
          }
        }
      },
      "required": [
        "taxonomy",
        "scope",
        "min_sample",
        "current",
        "monthly",
        "by_seniority"
      ]
    }
  },
  "required": [
    "schema_version",
    "dataset",
    "generated_at",
    "run_id",
    "data_window",
    "coverage",
    "data"
  ]
}